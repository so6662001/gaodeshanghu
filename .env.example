# ---------------------------------------------------------------------------
# 货袋子增长平台 环境变量示例
# 复制为 .env 后填写真实值：cp .env.example .env
# ---------------------------------------------------------------------------

# ===== 基础 =====
APP_NAME=货袋子增长运营平台
APP_ENV=dev
# 后台登录令牌，前端与 API 调用需携带 X-Api-Token
ADMIN_TOKEN=change-me-please
# 对外可访问的站点地址，用于生成短链
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ===== 数据库 =====
# 默认 SQLite，生产建议 PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/huodaizi
DATABASE_URL=sqlite:///./data/huodaizi.db

# ===== 高德开放平台（Web 服务 Key）=====
# 申请地址 https://console.amap.com/dev/key/app  服务平台需选择「Web服务」
AMAP_KEY=
# 若开启了数字签名，填写私钥；未开启留空
AMAP_SIG_SECRET=
# Web 服务 Key 的 QPS 限制，个人开发者一般为 3，企业认证更高
AMAP_QPS=3
# 单次关键字搜索高德最多返回 1000 条，超出请使用网格化采集
AMAP_MAX_RESULTS_PER_QUERY=1000

# ===== 创蓝 253 短信 =====
# 控制台 https://zz.253.com/  API 账号并非登录账号
CHUANGLAN_ACCOUNT=
CHUANGLAN_PASSWORD=
CHUANGLAN_BASE_URL=https://smssh1.253.com
# 短信签名，会自动拼在内容最前面，如【货袋子】
SMS_SIGN=【货袋子】
# 发送速率：每秒最多提交多少条（创蓝默认限制较高，按套餐调整）
SMS_QPS=20
# 变量短信单批最大手机号数量
SMS_BATCH_SIZE=500
# 是否为演练模式：true 时不真实调用短信接口，只写入发送记录（上线前务必先跑演练）
SMS_DRY_RUN=true

# ===== 合规风控（营销短信红线，请勿随意放宽）=====
# 允许发送的时间窗（24 小时制），法规与运营商要求：不得夜间打扰
SMS_SEND_WINDOW_START=09:00
SMS_SEND_WINDOW_END=20:00
# 同一手机号最小触达间隔（天）
SMS_MIN_INTERVAL_DAYS=7
# 同一手机号 30 天内最多触达次数
SMS_MAX_TOUCH_PER_MONTH=3
# 退订关键词，命中即自动加入黑名单
SMS_UNSUBSCRIBE_KEYWORDS=TD,T,N,退订,拒收,QX
